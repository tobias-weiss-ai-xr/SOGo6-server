# Development Dockerfile for SOGo 6 Server
# Single stage for development (source will be mounted by compose)

FROM python:3.14-slim AS development

WORKDIR /app

# Install system dependencies including LDAP and PostgreSQL
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    libpq-dev \
    libldap2-dev \
    libsasl2-dev \
    libxml2-dev \
    libxmlsec1-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FLASK_ENV=development \
    FLASK_DEBUG=1 \
    PIP_NO_CACHE_DIR=off

# Install all dependencies directly via pip (avoids poetry lock file issues)
COPY pyproject.toml ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
        debugpy watchdog flask-debugtoolbar \
        flask flask-compress flask-cors flask-smorest \
        gunicorn celery \
        prometheus-client authlib pyotp qrcode[pil] webauthn \
        marshmallow icalendar defusedxml \
        psycopg[binary] mysql-connector-python python-ldap redis \
        cryptography pyjwt pydantic pydantic-settings bcrypt \
        sievelib yarl pysaml2 || \
    echo "Some packages failed - will check at runtime"

# Copy source code (will be mounted by compose in dev)
COPY . ./

# Expose app port and debug port
EXPOSE 5000 5678

# Run with debug and auto-reload using app/run.py
CMD ["python", "-m", "debugpy", "--listen", "0.0.0.0:5678", \
     "app/run.py", "--host=0.0.0.0", "--port=5000", "--debug"]
